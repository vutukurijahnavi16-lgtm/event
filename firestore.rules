rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Students can create only their own student profile, never an admin profile.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.email is string
        && request.resource.data.rollNumber is string;
      allow update, delete: if isAdmin();
    }

    match /rollNumbers/{roll} {
      allow read: if signedIn();
      // Signup uses a transaction; prevent overwriting a claimed roll number.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/rollNumbers/$(roll));
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isStudent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrations'])
          && request.resource.data.registrations is list
          && request.resource.data.registrations.size() <= resource.data.capacity
          && request.auth.uid in request.resource.data.registrations);
    }
  }
}
